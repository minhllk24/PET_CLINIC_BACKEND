# Server Configuration
PORT=8080
NODE_ENV=development

# Database (MongoDB Mongoose)
MONGODB_URI=mongodb://localhost:27017/pet_clinic_db

# JWT & Authentication Secrets
JWT_ACCESS_TOKEN_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_RESET_TOKEN_SECRET=your_jwt_reset_secret_min_32_chars

# CORS Allowed Origins
CUSTOMER_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:4200

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email SMTP (Nodemailer)
EMAIL_APP=your_email@gmail.com
EMAIL_APP_PASSWORD=your_email_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Logging
LOG_LEVEL=info
